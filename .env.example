BIRDEYE_API_KEY=your_birdeye_api_key
HELIUS_API_KEY=your_helius_api_key
LAMBDA_P2P_API_KEY=your_lambda_p2p_api_key
DIALECT_API_KEY=your_dialect_api_key

METRICS_SECRET=replace_with_random_32_bytes

# Signs vault session JWTs. If unset or shorter than 32 chars, the server
# refuses to start. Rotating this invalidates every user's session.
JWT_SECRET=replace_with_random_32_bytes

# Optional: telegram notifications for signups/usage
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=3000

# Encrypted vault — SQLite path. The directory must exist and be writable
# by the process. In dev, a relative path is fine; in prod see deploy/.
VAULT_DB_PATH=./data/vault.db

# Optional: Cloudflare Turnstile bot protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
