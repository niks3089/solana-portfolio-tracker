# Database
DATABASE_URL=postgresql://{{ postgres_user }}:{{ postgres_password }}@localhost:5432/{{ postgres_db }}

# Server
PORT={{ app_port }}
NODE_ENV=production

# API Keys
BIRDEYE_API_KEY={{ birdeye_api_key }}
DIALECT_API_KEY={{ dialect_api_key }}
LAMBDA_P2P_API_KEY={{ lambda_p2p_api_key }}

# Payment
PAYMENT_WALLET={{ payment_wallet }}

# Free mode - set to 'true' to make everything free (no wallet connection required)
FREE_MODE={{ free_mode | default('true') }}

# Metrics secret (to access /api/metrics?secret=xxx)
METRICS_SECRET={{ metrics_secret | default('saul_metrics_2024') }}

